PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication
JWT_SECRET=replace_with_secure_random_key_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Persistence Layer
MONGODB_URI=mongodb://ayur_admin:ayur_secure_password@localhost:27017/ayurvarta?authSource=admin
REDIS_URL=redis://:ayur_redis_password@localhost:6379/0

# Internal ML Service Connectivity
ML_SERVICE_URL=http://localhost:8001
INTERNAL_SERVICE_KEY=dev_internal_secret_key_123

# Telehealth (Agora RTC)
AGORA_APP_ID=mock_agora_app_id
AGORA_APP_CERTIFICATE=mock_agora_app_certificate
