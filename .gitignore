# Monorepo Root .gitignore — AyurVarta

# Dependencies
node_modules/
frontend/node_modules/
backend/**/node_modules/

# Python Virtual Environments & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/

# Build & Static Outputs
build/
frontend/build/
dist/
.vercel/
*.egg-info/
.eggs/

# Logs & Runtime
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Configurations (Never commit secrets)
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
backend/.env
backend/.env.*
!backend/.env.example
ml-service/.env
ml-service/.env.*
!ml-service/.env.example

# Local Database & Cache Mounts
mongodb_data/
redis_data/
qdrant_data/

# OS & Editor Specifics
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
